{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    ".vitepress/**/*.ts",
    "glossary/**/*.ts",
    "viz/**/*.ts",
    "viz/**/*.vue",
    "components/**/*.vue",
    "scripts/**/*.ts"
  ]
}
